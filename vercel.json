{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci --prefix public-web",
  "buildCommand": "npm run build --prefix public-web && node scripts/build-vercel.cjs",
  "outputDirectory": "dist-web",
  "framework": null,
  "cleanUrls": true,
  "headers": [
    {
      "source": "/gennetex/admin/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/app/(.*\\.apk)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/vnd.android.package-archive"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/app",
      "destination": "/app/index.html"
    },
    {
      "source": "/gennetex/admin",
      "destination": "/gennetex/admin/index.html"
    },
    {
      "source": "/about",
      "destination": "/"
    },
    {
      "source": "/services",
      "destination": "/"
    },
    {
      "source": "/projects",
      "destination": "/"
    },
    {
      "source": "/contact",
      "destination": "/"
    },
    {
      "source": "/careers",
      "destination": "/"
    }
  ]
}
