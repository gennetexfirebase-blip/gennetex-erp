{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci --prefix public-web && npm ci --prefix admin-web-react",
  "buildCommand": "npm run build --prefix public-web && npm run build --prefix admin-web-react && node scripts/build-vercel.cjs",
  "outputDirectory": "dist-web",
  "framework": null,
  "functions": {
    "api/**/*.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/vehicle-compliance-cron",
      "schedule": "5 1 * * *"
    }
  ],
  "cleanUrls": true,
  "headers": [
    {
      "source": "/gennetex/admin/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/app/latest.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        }
      ]
    },
    {
      "source": "/app",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/app/uplaod",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/app/(.*\\.apk)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/vnd.android.package-archive"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/app",
      "destination": "/app/index.html"
    },
    {
      "source": "/gennetex/admin",
      "destination": "/gennetex/admin/index.html"
    },
    {
      "source": "/gennetex/admin/:path*",
      "destination": "/gennetex/admin/"
    },
    {
      "source": "/((?!gennetex/|app/|app$|assets/).*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "admin.gennetex.com"
        }
      ],
      "destination": "https://admin.gennetex.com/gennetex/admin/",
      "permanent": false
    },
    {
      "source": "/(.*)",
      "missing": [
        {
          "type": "host",
          "value": "((www\\.)?gennetex\\.com|admin\\.gennetex\\.com)"
        }
      ],
      "destination": "https://gennetex.com/$1",
      "permanent": true
    }
  ]
}
