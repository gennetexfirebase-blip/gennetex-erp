{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci --prefix public-web && npm ci --prefix admin-web-react",
  "buildCommand": "npm run build --prefix public-web && npm run build --prefix admin-web-react && node scripts/build-vercel.cjs",
  "outputDirectory": "dist-web",
  "framework": null,
  "cleanUrls": true,
  "headers": [
    {
      "source": "/gennetex/admin/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "comment": "Манифест ба татах хуудас — CDN дээр ХЭЗЭЭ Ч кэшлэхгүй. Эс бөгөөс шинэ хувилбар гаргасан ч хэрэглэгч хуучин дугаарыг хардаг бөгөөд hard refresh (Ctrl+Shift+R) ч тусладаггүй: кэш нь браузерт биш, Vercel-ийн ирмэг дээр байдаг.",
      "source": "/app/latest.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        }
      ]
    },
    {
      "source": "/app",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/app/uplaod",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/app/(.*\\.apk)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/vnd.android.package-archive"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/app",
      "destination": "/app/index.html"
    },
    {
      "source": "/gennetex/admin",
      "destination": "/gennetex/admin/index.html"
    },
    {
      "source": "/gennetex/admin/((?!assets/).*)",
      "destination": "/gennetex/admin/index.html"
    },
    {
      "source": "/about",
      "destination": "/"
    },
    {
      "source": "/services",
      "destination": "/"
    },
    {
      "source": "/projects",
      "destination": "/"
    },
    {
      "source": "/contact",
      "destination": "/"
    },
    {
      "source": "/careers",
      "destination": "/"
    },
    {
      "source": "/privacy",
      "destination": "/"
    },
    {
      "source": "/terms",
      "destination": "/"
    }
  ]
}
