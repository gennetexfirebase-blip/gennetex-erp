{
  "expo": {
    "name": "Gennetex ERP",
    "slug": "gennetex-erp",
    "scheme": "gennetex-erp",
    "version": "1.1.4",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification",
          "location",
          "fetch",
          "voip",
          "audio"
        ],
        "NSLocationWhenInUseUsageDescription": "Ажилтны байршлыг real-time харуулахад байршлын зөвшөөрөл шаардлагатай.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Ажилтны байршлыг ард нь ажиллаж байхад хянахад шаардлагатай.",
        "NSCameraUsageDescription": "Барааны зураасан код (barcode) унших, царайгаар ирц бүртгэх, видео дуудлагад камер шаардлагатай.",
        "NSMicrophoneUsageDescription": "Видео дуудлага болон дуу хоолойгоор мессеж бичихэд микрофон шаардлагатай.",
        "NSSpeechRecognitionUsageDescription": "Монгол дуу хоолойгоор чат бичихэд яриа таних зөвшөөрөл шаардлагатай.",
        "NSPhotoLibraryUsageDescription": "Профайл зураг сонгоход зургийн санд хандах шаардлагатай.",
        "NSFaceIDUsageDescription": "Gennetex ERP-г нууц үггүй аюулгүй нээхэд Face ID ашиглана.",
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationAlwaysUsageDescription": "Ажилтны байршлыг ажлын цагт тасралтгүй хянахад шаардлагатай."
      },
      "config": {
        "googleMapsApiKey": "AIzaSyAOVYRIgupAurZup5y1PRh8Ismb1A3lLao"
      },
      "bundleIdentifier": "com.gennetex.erp",
      "entitlements": {
        "com.apple.developer.pushkit.unrestricted-voip": true
      }
    },
    "android": {
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO",
        "android.permission.VIBRATE",
        "android.permission.WAKE_LOCK",
        "android.permission.USE_FULL_SCREEN_INTENT",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_PHONE_CALL",
        "android.permission.DISABLE_KEYGUARD",
        "android.permission.MANAGE_OWN_CALLS",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE",
        "android.permission.FOREGROUND_SERVICE_CAMERA",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.READ_PHONE_STATE",
        "android.permission.CALL_PHONE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyAOVYRIgupAurZup5y1PRh8Ismb1A3lLao"
        }
      },
      "package": "com.gennetex.erp",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/logo.png"
    },
    "plugins": [
      "./plugins/withFirebaseManifestFix",
      "@react-native-firebase/app",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Ажилтны байршлыг хянахад зөвшөөрөл олгоно уу.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Барааны зураасан код (barcode) унших, ирц бүртгэхэд камер ашиглана.",
          "microphonePermission": "Видео дуудлага хийхэд микрофон ашиглана."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Профайл зураг сонгоход зургийн санд хандана.",
          "cameraPermission": "Профайл зураг авахад камер ашиглана."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#0099db",
          "defaultChannel": "default",
          "sounds": [
            "./assets/sounds/incoming_call.wav"
          ]
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Дуу хоолойгоор чат бичихэд микрофон ашиглана.",
          "speechRecognitionPermission": "Монгол дуу хоолой танихад яриа таних зөвшөөрөл шаардлагатай.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Gennetex ERP-г нууц үггүй аюулгүй нээхэд Face ID ашиглана."
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      "expo-web-browser",
      "expo-dev-client",
      [
        "react-native-full-screen-notification-incoming-call",
        {
          "statusBarColor": "#201e1f"
        }
      ],
      "@config-plugins/react-native-webrtc",
      [
        "@config-plugins/react-native-callkeep",
        {}
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "5c8b7868-880a-4c81-aa6c-f5ec464d0d22"
      }
    }
  }
}
