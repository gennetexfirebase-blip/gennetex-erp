{
  "expo": {
    "name": "Gennetex ERP",
    "slug": "gennetex-erp",
    "scheme": "gennetex-erp",
    "version": "1.3.7",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification",
          "location",
          "voip",
          "audio"
        ],
        "NSLocationWhenInUseUsageDescription": "Ажилтны байршлыг real-time харуулахад байршлын зөвшөөрөл шаардлагатай.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Ажилтны байршлыг ард нь ажиллаж байхад хянахад шаардлагатай.",
        "NSCameraUsageDescription": "Барааны зураасан код (barcode) унших, царайгаар ирц бүртгэх, видео дуудлагад камер шаардлагатай.",
        "NSMicrophoneUsageDescription": "Видео дуудлага болон дуу хоолойгоор мессеж бичихэд микрофон шаардлагатай.",
        "NSSpeechRecognitionUsageDescription": "Монгол дуу хоолойгоор чат бичихэд яриа таних зөвшөөрөл шаардлагатай.",
        "NSPhotoLibraryUsageDescription": "Профайл зураг сонгоход зургийн санд хандах шаардлагатай.",
        "NSFaceIDUsageDescription": "Gennetex ERP-г нууц үггүй аюулгүй нээхэд Face ID ашиглана.",
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationAlwaysUsageDescription": "Ажилтны байршлыг ажлын цагт тасралтгүй хянахад шаардлагатай."
      },
      "bundleIdentifier": "com.gennetex.erp",
      "entitlements": {
        "com.apple.developer.pushkit.unrestricted-voip": true
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyCollectedDataTypes": [
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypePreciseLocation",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeName",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeEmailAddress",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypePhoneNumber",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypePhotosorVideos",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeOtherUserContent",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeSensitiveInfo",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeDeviceID",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeProductInteraction",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeAudioData",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeCrashData",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          }
        ],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          }
        ]
      },
      "buildNumber": "1",
      "usesAppleSignIn": true
    },
    "android": {
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO",
        "android.permission.VIBRATE",
        "android.permission.WAKE_LOCK",
        "android.permission.USE_FULL_SCREEN_INTENT",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_PHONE_CALL",
        "android.permission.DISABLE_KEYGUARD",
        "android.permission.MANAGE_OWN_CALLS",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE",
        "android.permission.FOREGROUND_SERVICE_CAMERA",
        "android.permission.READ_PHONE_STATE"
      ],
      "blockedPermissions": [
        "android.permission.CALL_PHONE",
        "android.permission.READ_PHONE_NUMBERS",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.USE_FINGERPRINT"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.gennetex.erp",
      "googleServicesFile": "./google-services.json",
      "versionCode": 2,
      "allowBackup": false
    },
    "web": {
      "favicon": "./assets/logo.png"
    },
    "plugins": [
      "./plugins/withFirebaseManifestFix",
      "./plugins/withIncomingCallManifest",
      "@react-native-firebase/app",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Ажилтны байршлыг хянахад зөвшөөрөл олгоно уу.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Барааны зураасан код (barcode) унших, ирц бүртгэхэд камер ашиглана.",
          "microphonePermission": "Видео дуудлага хийхэд микрофон ашиглана."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Профайл зураг сонгоход зургийн санд хандана.",
          "cameraPermission": "Профайл зураг авахад камер ашиглана."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#0099db",
          "defaultChannel": "general_v2",
          "sounds": [
            "./assets/sounds/incoming_call.wav"
          ]
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Дуу хоолойгоор чат бичихэд микрофон ашиглана.",
          "speechRecognitionPermission": "Монгол дуу хоолой танихад яриа таних зөвшөөрөл шаардлагатай.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Gennetex ERP-г нууц үггүй аюулгүй нээхэд Face ID ашиглана."
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      "expo-web-browser",
      "expo-dev-client",
      [
        "react-native-full-screen-notification-incoming-call",
        {
          "statusBarColor": "#201e1f"
        }
      ],
      "@config-plugins/react-native-webrtc",
      [
        "@config-plugins/react-native-callkeep",
        {}
      ],
      "expo-apple-authentication",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 24,
            "enableMinifyInReleaseBuilds": false,
            "enableShrinkResourcesInReleaseBuilds": false,
            "extraProguardRules": "# ⚠️ ЭДГЭЭР ДҮРЭМ БЭЛЭН БОЛОВЧ MINIFY УНТРААЛТТАЙ БАЙНА.\n#    Асаахдаа `enableMinifyInReleaseBuilds` болон\n#    `enableShrinkResourcesInReleaseBuilds`-ыг `true` болгоно.\n#\n#    ⚠️ Асаасны дараа ЗААВАЛ БОДИТ ТӨХӨӨРӨМЖ ДЭЭР release APK-г\n#       турших ёстой. R8-ийн алдаа нь зөвхөн release build дээр,\n#       зөвхөн ажиллах үед илэрдэг — debug дээр огт харагдахгүй.\n#       Тусгайлан шалгах: царай таних (ONNX), видео дуудлага\n#       (WebRTC/CallKeep), ирэх дуудлагын бүтэн дэлгэц, QR уншигч.\n\n# ── ONNX Runtime — JNI-аар класс хайдаг ─────────────────────\n-keep class ai.onnxruntime.** { *; }\n-keep class com.microsoft.onnxruntime.** { *; }\n-dontwarn ai.onnxruntime.**\n\n# ── WebRTC — натив талаас callback дууддаг ──────────────────\n-keep class org.webrtc.** { *; }\n-dontwarn org.webrtc.**\n-keep class com.oney.WebRTCModule.** { *; }\n\n# ── CallKeep / ирэх дуудлага — ConnectionService reflection ──\n-keep class io.wazo.callkeep.** { *; }\n-keep class com.reactnativefullscreennotificationincomingcall.** { *; }\n\n# ── ML Kit царай илрүүлэх ───────────────────────────────────\n-keep class com.google.mlkit.** { *; }\n-keep class com.google.android.gms.internal.mlkit_** { *; }\n-dontwarn com.google.mlkit.**\n\n# ── Firebase / GMS ──────────────────────────────────────────\n-keep class com.google.firebase.** { *; }\n-dontwarn com.google.android.gms.**\n\n# ── React Native цөм ────────────────────────────────────────\n-keep class com.facebook.react.turbomodule.** { *; }\n-keep class com.facebook.jni.** { *; }\n-keepclassmembers class * { @com.facebook.proguard.annotations.DoNotStrip *; }\n"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "5c8b7868-880a-4c81-aa6c-f5ec464d0d22"
      }
    }
  }
}
