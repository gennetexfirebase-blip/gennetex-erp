{
  "name": "gennetex-erp",
  "version": "1.3.1",
  "main": "index.js",
  "scripts": {
    "start": "expo start --dev-client",
    "start:go": "expo start",
    "start:tunnel": "node scripts/check-ngrok-auth.js && node scripts/patch-expo-ngrok-timeout.js && expo start --tunnel",
    "android": "node scripts/fix-android-sdk-path.js && expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "version:bump": "node scripts/bump-version.js",
    "admin:sync-env": "node scripts/sync-admin-env.js",
    "admin:serve": "python3 -m http.server 5500 --directory admin-web",
    "postinstall": "node scripts/patch-incoming-call-rn81.js && node scripts/sync-google-services.js && node scripts/patch-expo-ngrok-timeout.js",
    "eas-build-post-install": "node scripts/patch-incoming-call-rn81.js && node scripts/sync-google-services.js",
    "android:apk": "node scripts/fix-android-sdk-path.js && node scripts/patch-incoming-call-rn81.js && cd android && gradlew assembleDebug -PreactNativeArchitectures=arm64-v8a",
    "prebuild:android": "expo prebuild --platform android --clean && node scripts/fix-android-sdk-path.js && node scripts/setup-release-signing.js",
    "android:release": "node scripts/fix-android-sdk-path.js && node scripts/setup-release-signing.js && node scripts/patch-incoming-call-rn81.js && cd android && gradlew assembleRelease",
    "app:publish": "node scripts/publish-app-build.js"
  },
  "dependencies": {
    "@config-plugins/react-native-callkeep": "^14.0.1",
    "@config-plugins/react-native-webrtc": "^15.0.1",
    "@infinitered/react-native-mlkit-face-detection": "^5.0.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "11.4.1",
    "@react-native-firebase/app": "26.1.0",
    "@react-native-firebase/messaging": "26.1.0",
    "@react-navigation/bottom-tabs": "^6.6.1",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.11.0",
    "@supabase/supabase-js": "^2.110.0",
    "base64-arraybuffer": "^1.0.2",
    "buffer": "^6.0.3",
    "events": "^3.3.0",
    "expo": "~54.0.36",
    "expo-application": "~7.0.8",
    "expo-auth-session": "~7.0.11",
    "expo-av": "~16.0.8",
    "expo-blur": "~15.0.8",
    "expo-camera": "~17.0.10",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.13",
    "expo-crypto": "~15.0.9",
    "expo-dev-client": "~6.0.21",
    "expo-device": "~8.0.10",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.23",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-intent-launcher": "~13.0.8",
    "expo-linear-gradient": "~15.0.8",
    "expo-local-authentication": "~17.0.8",
    "expo-location": "~19.0.8",
    "expo-network": "~8.0.7",
    "expo-notifications": "~0.32.17",
    "expo-print": "~15.0.8",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-speech": "~14.0.8",
    "expo-speech-recognition": "^3.1.3",
    "expo-status-bar": "~3.0.9",
    "expo-task-manager": "~14.0.9",
    "expo-web-browser": "~15.0.11",
    "jpeg-js": "^0.4.4",
    "js-sha1": "^0.7.0",
    "js-sha256": "^0.11.1",
    "js-sha512": "^0.9.0",
    "onnxruntime-react-native": "^1.20.1",
    "process": "^0.11.10",
    "qrcode-generator": "^2.0.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-callkeep": "^4.3.16",
    "react-native-full-screen-notification-incoming-call": "^1.1.0",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-get-random-values": "~1.11.0",
    "react-native-incall-manager": "^4.2.2",
    "react-native-maps": "1.20.1",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-view-shot": "4.0.3",
    "react-native-web": "^0.21.2",
    "react-native-webrtc": "^124.0.8",
    "react-native-webview": "13.15.0",
    "telegram": "^2.26.22"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.1.10",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.1",
    "typescript": "~5.9.2"
  },
  "private": true
}
