{
  "name": "gennetex-erp",
  "version": "1.3.10",
  "main": "index.js",
  "scripts": {
    "start": "node scripts/patch-expo-platform-header.js && node scripts/expo-start.js --dev-client",
    "start:go": "node scripts/check-ngrok-auth.js && node scripts/patch-expo-ngrok-timeout.js && node scripts/patch-expo-platform-header.js && node scripts/expo-start.js --tunnel --go",
    "start:tunnel": "node scripts/check-ngrok-auth.js && node scripts/patch-expo-ngrok-timeout.js && node scripts/patch-expo-platform-header.js && node scripts/expo-start.js --tunnel --dev-client",
    "android": "node scripts/fix-android-sdk-path.js && expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "version:bump": "node scripts/bump-version.js",
    "admin:sync-env": "node scripts/sync-admin-env.js",
    "admin:serve": "python3 -m http.server 5500 --directory admin-web",
    "postinstall": "node scripts/patch-incoming-call-rn81.js && node scripts/sync-google-services.js && node scripts/patch-expo-ngrok-timeout.js && node scripts/patch-expo-platform-header.js",
    "eas-build-post-install": "node scripts/patch-incoming-call-rn81.js && node scripts/sync-google-services.js",
    "android:apk": "node scripts/fix-android-sdk-path.js && node scripts/patch-incoming-call-rn81.js && cd android && gradlew assembleDebug -PreactNativeArchitectures=arm64-v8a",
    "prebuild:android": "expo prebuild --platform android --clean && node scripts/fix-android-sdk-path.js && node scripts/setup-release-signing.js",
    "android:release": "node scripts/fix-android-sdk-path.js && node scripts/setup-release-signing.js && node scripts/patch-incoming-call-rn81.js && cd android && gradlew assembleRelease",
    "app:publish": "node scripts/publish-app-build.js",
    "serve:local": "node scripts/serve-local.js"
  },
  "dependencies": {
    "@config-plugins/react-native-callkeep": "^14.0.1",
    "@config-plugins/react-native-webrtc": "^15.0.1",
    "@infinitered/react-native-mlkit-face-detection": "^5.0.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-firebase/app": "26.1.0",
    "@react-native-firebase/messaging": "26.1.0",
    "@react-navigation/bottom-tabs": "^6.6.1",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.11.0",
    "@supabase/supabase-js": "^2.110.0",
    "base64-arraybuffer": "^1.0.2",
    "buffer": "^6.0.3",
    "events": "^3.3.0",
    "expo": "^57.0.0",
    "expo-apple-authentication": "~57.0.1",
    "expo-application": "~57.0.2",
    "expo-asset": "~57.0.16",
    "expo-audio": "~57.0.4",
    "expo-auth-session": "~57.0.11",
    "expo-blur": "~57.0.2",
    "expo-build-properties": "~57.0.16",
    "expo-camera": "~57.0.4",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.17",
    "expo-crypto": "~57.0.2",
    "expo-dev-client": "~57.0.18",
    "expo-device": "~57.0.1",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.6",
    "expo-image-manipulator": "~57.0.15",
    "expo-image-picker": "~57.0.15",
    "expo-intent-launcher": "~57.0.1",
    "expo-linear-gradient": "~57.0.1",
    "expo-local-authentication": "~57.0.2",
    "expo-location": "~57.0.15",
    "expo-network": "~57.0.1",
    "expo-notifications": "~57.0.16",
    "expo-print": "~57.0.1",
    "expo-secure-store": "~57.0.3",
    "expo-sharing": "~57.0.17",
    "expo-speech": "~57.0.2",
    "expo-speech-recognition": "^3.1.3",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-task-manager": "~57.0.15",
    "expo-video": "~57.0.3",
    "expo-web-browser": "~57.0.2",
    "jpeg-js": "^0.4.4",
    "js-sha1": "^0.7.0",
    "js-sha256": "^0.11.1",
    "js-sha512": "^0.9.0",
    "onnxruntime-react-native": "^1.20.1",
    "process": "^0.11.10",
    "qrcode-generator": "^2.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-callkeep": "^4.3.16",
    "react-native-full-screen-notification-incoming-call": "^1.1.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-get-random-values": "~1.11.0",
    "react-native-incall-manager": "^4.2.2",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-view-shot": "5.1.0",
    "react-native-web": "^0.21.2",
    "react-native-webrtc": "^124.0.8",
    "react-native-webview": "13.16.1",
    "telegram": "^2.26.22"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.2.4",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "typescript": "~6.0.3"
  },
  "private": true
}
